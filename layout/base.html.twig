<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/theme/favicon.ico">
  <title>
    {% set titleBlock = block("title") %}
    {% if titleBlock is not empty %}
      {% block title %}{% endblock %} |
    {% endif %}
    {{ app.currentSite.site.title }}
  </title>

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/meyer-reset/2.0/reset.min.css"
    integrity="sha512-NmLkDIU1C/C88wi324HBc+S2kLhi08PN5GDeUVVVC/BVt/9Izdsc9SVeVfA1UZbY3sHUlDSyRXhCzHfr6hmPPw=="
    crossorigin="anonymous"
    referrerpolicy="no-referrer"
  />

  {# biblys assets #}
  {% include "layout:_assets_css.html.twig" %}

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
    integrity="sha512-SfTiTlX6kk+qitfevl/7LibUOeJWlt9rbyDn92a1DqWOw9vWG2MFoays0sgObmWazO5BQPiFucnnEAjpAB+/Sw=="
    crossorigin="anonymous"
    referrerpolicy="no-referrer"
  />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto">
  <link rel="stylesheet" href="/theme/styles.css?{{ app.currentSite.getOption('assets_version') }}">

  <link rel="alternate" type="application/rss+xml" title="Les derniers billets du blog" href="{{ path('feed_blog') }}">
  <link rel="alternate" type="application/rss+xml" title="Les dernières parutions du catalogue" href="{{ path('feed_catalog') }}">

  {% include "layout:_analytics.html.twig" %}
</head>
<body>
{% include "layout:_overall_menu.html.twig" %}

<div class="container-lg">
  <header class="mb-4">
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
      <a class="navbar-brand" href="/">
        <img src="/theme/logo.png" alt="{{ app.currentSite.site.title }}" height="40">
      </a>
      <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent"
              aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav mr-auto">
          <li class="nav-item">
            <a class="nav-link" href="/blog/actualites/">Actualités</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/blog/zalem-a-la-folie/">Zalem à la folie</a>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-toggle="dropdown" aria-expanded="false">
              Rayons
            </a>
            <div class="dropdown-menu">
              <a class="dropdown-item" href="/rayon/art">Art</a>
              <a class="dropdown-item" href="/rayon/bande-dessinee">Bande dessinée</a>
              <a class="dropdown-item" href="/rayon/essais-revues">Essais</a>
              <a class="dropdown-item" href="/rayon/fantastique">Fantastique</a>
              <a class="dropdown-item" href="/rayon/fantasy">Fantasy</a>
              <a class="dropdown-item" href="/rayon/jeunesse">Jeunesse</a>
              <a class="dropdown-item" href="/rayon/jeux-de-role">Jeux de rôle</a>
              <a class="dropdown-item" href="/rayon/science-fiction">Science-fiction</a>
              <a class="dropdown-item" href="/rayon/vo-english">VO</a>
            </div>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/evenements/">Évènements</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/page/a-propos">À propos</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/contact/">Contact</a>
          </li>
        </ul>
      </div>
    </nav>
  </header>

  <main class="site-main">
    {% include "layout:_flash_messages.html.twig" %}

    {% block main %}{% endblock %}
  </main>
</div>

<footer class="site-footer">
  <div class="container-lg site-footer__columns">
    <section class="site-footer__column site-footer__identity">
      <img class="site-footer__logo" src="/theme/logo.png" alt="{{ app.currentSite.site.title }}">
      <address class="site-footer__address">
        8 rue Riesener<br>
        75012 Paris
      </address>
      <p class="site-footer__transports">
        Métro Montgallet (ligne 8)<br>
        Bus — arrêts Montgallet et Mairie du 12<sup>e</sup>
      </p>
    </section>

    <section class="site-footer__column">
      <h2 class="site-footer__title">Horaires</h2>
      <dl class="site-footer__opening-hours">
        {% for day in [
          { name: "Lundi", hours: "10h30 – 19h30" },
          { name: "Mardi", hours: null },
          { name: "Mercredi", hours: "10h30 – 19h30" },
          { name: "Jeudi", hours: null },
          { name: "Vendredi", hours: "10h30 – 19h30" },
          { name: "Samedi", hours: "10h30 – 19h30" },
          { name: "Dimanche", hours: null }
        ] %}
          <div class="site-footer__day {{ day.hours is null ? "site-footer__day--closed" }}">
            <dt>{{ day.name }}</dt>
            <dd>{{ day.hours ?? "fermé" }}</dd>
          </div>
        {% endfor %}
      </dl>
    </section>

    <section class="site-footer__column">
      <h2 class="site-footer__title">La librairie</h2>
      <ul class="site-footer__links">
        <li><a href="/page/a-propos">À propos</a></li>
        <li><a href="/evenements/">Évènements</a></li>
        <li><a href="/blog/zalem-a-la-folie/">Zalem à la folie</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/page/mentions-legales">Mentions légales</a></li>
        <li><a href="/page/conditions-generales-de-vente">Conditions générales de vente</a></li>
        <li>
          <a href="{{ path('feed_index') }}" target="_blank">
            Flux RSS
            <span aria-hidden="true" class="fa fa-rss-square"></span>
          </a>
        </li>
      </ul>
    </section>

    <section class="site-footer__column">
      <h2 class="site-footer__title">Newsletter</h2>
      <form class="site-footer__newsletter" method="post" action="/mailing/subscribe">
        <fieldset>
          <input type="email" name="email" placeholder="Votre adresse e-mail" class="form-control"
                 aria-label="Votre adresse e-mail">
          <input class="btn btn-info btn-sm btn-block" type="submit" value="S’abonner">
        </fieldset>
      </form>
    </section>
  </div>

  <p class="powered-by">
    propulsé par <a href="https://biblys.org">biblys</a> · logiciel libre
  </p>
</footer>
{% include "layout:_assets_js.html.twig" %}
</body>
</html>

